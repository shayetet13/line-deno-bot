# (.env.example in this folder is the worker runtime env — different file.)
# Copy to .env next to docker-compose.yml on vps3 (172.237.2.229).
# The container runs as this uid/gid, so chown the bind-mounted state to match:
#   chown -R 1000:1000 /opt/line-first-response/{config,.sessions,.control}
LFR_UID=1000
LFR_GID=1000
IMAGE_TAG=latest

# Backend listens on loopback only; `front` (nginx, same compose file)
# reaches it over 127.0.0.1 on this same host — no separate edge host.
VPS3_PORT=8791

# Host directory holding config/, .sessions/ and .control/.
LFR_ROOT=/opt/line-first-response

# Optional build stamps shown by the console (docker compose build).
# GIT_COMMIT=
# BUILT_AT_MS=
