[Unit]
Description=line-first-response worker
Documentation=file:///opt/line-first-response/current/docs/runbook.md
After=network-online.target chronyd.service
Wants=network-online.target
# The clock matters: inbound latency is measured against LINE's timestamp, so
# a worker started before chrony has stepped the clock reports fiction.
Wants=chronyd.service
# A worker that dies mid-job should come back, but a crash loop must not hide
# itself: five restarts in a minute stops the unit so someone has to look.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/line-first-response/current
Environment=PATH=/root/.deno/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/opt/line-first-response/.env
ExecStart=/root/.deno/bin/deno task serve --config /opt/line-first-response/config/bots/bot-1.json --port 8791

Restart=always
RestartSec=5

# SIGTERM reaches the CLI's handler, which stops the receiver and waits for
# in-flight replies. Give it room to finish one before being killed.
KillSignal=SIGTERM
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lfr-worker

# The session files under .sessions ARE the LINE credentials; keep the unit
# from reading anything it has no business reading.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/line-first-response

[Install]
WantedBy=multi-user.target
