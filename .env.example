# ── Worker runtime ────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Correctness core (Phase 1) ───────────────────────────────────────────────
# Claim / dedupe stores: bounded TTL maps (Playbook §5.2 — no full sweeps).
CLAIM_INCOMING_TTL_MS=120000
CLAIM_INCOMING_MAX_ENTRIES=50000
CLAIM_REPLY_TTL_MS=120000
CLAIM_REPLY_MAX_ENTRIES=50000
CLAIM_ROOM_ANSWER_TTL_MS=120000
CLAIM_ROOM_ANSWER_MAX_ENTRIES=50000

# Per-(bot,room) admission control. Drop, do not queue (Playbook §6.3).
RATE_LIMIT_CAPACITY=5
RATE_LIMIT_REFILL_PER_SEC=2

# Job identity: how long a derived job key stays "seen" before a repeat of the
# same keyword is treated as a NEW job (decision doc §4, Phases §8).
JOB_KEY_TTL_MS=900000
JOB_REGISTRY_MAX_ENTRIES=10000

# Default timeout applied to any awaited external operation (Playbook §5.5).
DEFAULT_OP_TIMEOUT_MS=15000

# At most this many accounts may establish/re-establish PUSH + reply lanes at
# once. This is never applied to a live message send.
CONNECTION_WARMUP_CONCURRENCY=2
