{
  "version": "0.1.0",
  "workspace": [
    "./vendor/linejs/packages/linejs",
    "./vendor/linejs/packages/types"
  ],
  "nodeModulesDir": "auto",
  "imports": {
    "@line-first/contracts": "./packages/contracts/src/index.ts",
    "@std/assert": "jsr:@std/assert@^1.0.8",
    "@std/cli": "jsr:@std/cli@^1.0.9",
    "qrcode-terminal": "npm:qrcode-terminal@0.12.0",
    "qrcode": "npm:qrcode@1.5.4",
    "@std/expect": "jsr:@std/expect@^1.0.9",
    "@std/testing": "jsr:@std/testing@^1.0.5"
  },
  "tasks": {
    "login": "deno run -A apps/worker/src/cli/login.ts",
    "probe": "deno run -A apps/worker/src/cli/probe.ts",
    "bench": "deno run -A apps/worker/src/cli/bench.ts",
    "serve": "deno run -A apps/worker/src/cli/serve.ts",
    "acceptance": "deno run -A apps/worker/src/cli/acceptance.ts",
    "test": "deno test -A --coverage=coverage apps/worker/test",
    "check": "deno check apps/worker packages/contracts",
    "lint": "deno lint apps packages",
    "fmt": "deno fmt apps packages docs README.md deno.json",
    "fmt:check": "deno fmt --check apps packages docs README.md deno.json",
    "gate": "deno task fmt:check && deno task lint && deno task check && deno task test && deno coverage coverage --exclude=vendor/"
  },
  "fmt": {
    "useTabs": false,
    "singleQuote": true,
    "lineWidth": 100,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": ["no-console", "no-throw-literal", "eqeqeq"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "exclude": ["vendor/", "coverage/", "node_modules/"]
}
