# Files that run on Linux keep LF line endings in every checkout and in
# `git archive`, even on Windows with core.autocrlf=true — a CRLF shell script
# fails on its first line ("set: pipefail\r: invalid option name").
*.sh       text eol=lf
*.mjs      text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.conf     text eol=lf
Dockerfile text eol=lf
deploy/docker/*.yml text eol=lf
.husky/*   text eol=lf
